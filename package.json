{
  "name": "harry-huynh-personal-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5173",
    "studio": "node studio/server.mjs",
    "test:studio": "node --test tests/studio.test.mjs",
    "prebuild": "node scripts/generate-static-assets.mjs",
    "build": "next build",
    "host": "node scripts/serve-static.mjs out 5173 0.0.0.0",
    "preview": "node scripts/serve-static.mjs out 5173 127.0.0.1",
    "start": "pnpm run host",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --test tests/static-site.test.mjs tests/motion.test.mjs",
    "lint": "eslint app components lib scripts tests studio/*.mjs studio/*.jsx next.config.ts eslint.config.mjs",
    "new-post": "node scripts/new-post.mjs",
    "new-project": "node scripts/new-project.mjs",
    "new-album": "node scripts/new-album.mjs",
    "audit-images": "node scripts/audit-images.mjs"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.41.0",
    "marked": "^18.0.12",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
